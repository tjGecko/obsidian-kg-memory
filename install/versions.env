# Pinned versions for reproducible installs.
# Sourced by individual install steps when OBSIDIAN_KG_PIN_VERSIONS=1.
# Refresh periodically — these are the last-known-good versions for this stack.

NODE_VERSION="20.18.1"
PYTHON_VERSION="3.11"

CLAUDE_CODE_VERSION="latest"        # Anthropic ships fast; pinning hurts more than it helps.
CODEX_VERSION="0.128.0"             # Magnus reference.
HERMES_VERSION="0.12.0"             # Magnus reference (2026.4.30).

DATAVIEW_VERSION="0.5.74"           # Fallback if GitHub releases API is unavailable.

# macOS minimums.
MACOS_MIN_MAJOR="13"                # Ventura.
DISK_MIN_GB="10"
