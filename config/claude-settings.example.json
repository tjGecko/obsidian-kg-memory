{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "env": {
    "KG_VAULT": "~/Documents/KG-Vault"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(jq:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  },
  "skills": {
    "directories": [
      "~/.claude/skills"
    ]
  }
}
